{
  "name": "geospectrum-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "backend:dev": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8787",
    "frontend:dev": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "frontend:build": "npm --prefix frontend run build",
    "test": "python -m pytest -q",
    "generate:manifest": "python tools/generate_manifest.py",
    "sidecar:build": "python tools/build_sidecar.py",
    "sidecar:verify": "python tools/verify_sidecar.py",
    "tauri:build": "python tools/verify_sidecar.py && tauri build --ci",
    "release:internal": "python tools/build_sidecar.py && python tools/verify_sidecar.py && tauri build --ci && python tools/build_release_manifest.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
