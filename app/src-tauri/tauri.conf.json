{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoSpectrum",
  "version": "0.1.0",
  "identifier": "cn.geospectrum.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GeoSpectrum",
        "width": 1440,
        "height": 920,
        "minWidth": 1060,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/geospectrum-backend"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
