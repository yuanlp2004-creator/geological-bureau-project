# Only publish project entry files, application sources, and documentation.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/PLAN.md
!/app/
!/docs/

# Explicitly excluded from the public repository.
/Spec Source/
/Spec2.02/
/SpecFile/
/UI测试/

# Local-only runtime, diagnostics, and test artifacts.
/app/.local/
/app/.pytest_cache/
/app/**/__pycache__/
/app/**/.pytest_cache/
/app/**/.mypy_cache/
/app/**/.ruff_cache/
/app/**/.venv/
/app/**/venv/
*.py[cod]

# Generated frontend and Tauri build outputs.
/app/node_modules/
/app/frontend/node_modules/
/app/frontend/dist/
/app/src-tauri/target/
/app/frontend/*.tsbuildinfo

# Accidentally named test-cache outputs.
/app/v/

# Dependencies, compiler outputs, and local configuration at any depth.
node_modules/
__pycache__/
bin/
obj/
.env
.env.*
!.env.example
*.exe
*.dll
*.msi
*.msix
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log
*.pfx
*.p12
*.key
*.pem

# Keep release documentation, but not the portable demo's runtime data.
/docs/releases/**/demo-data/
