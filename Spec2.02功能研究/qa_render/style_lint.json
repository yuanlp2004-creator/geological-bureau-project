    {
      "para_index": 5,
      "text": "\u7a0b\u5e8f\u5165\u53e3\uff1aC:\\Users\\Hust\\Desktop\\\u5730\u8d28\u5c40\u9879\u76ee\\Spec2.02\\SpecDirect.exe",
      "style": "Normal"
